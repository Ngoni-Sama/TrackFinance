{
  "expo": {
    "name": "TrackFinance",
    "slug": "trackfinance",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "zw.trackfinance.app",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ],
      "blockedPermissions": [
        "android.permission.SEND_SMS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0078AA"
      },
      "versionCode": 2
    },
    "plugins": [
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrackFinance uses your photos to set a business logo and attach receipts.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "react-native-background-fetch",
      "./plugins/withReleaseSigning",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2fde46d1-4e8f-43ea-83b2-8d4918025b50"
      },
      "aiUrl": "https://trackfinance-ai.ma360-ngoni.workers.dev"
    },
    "owner": "ngoni-sama",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0078AA"
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
